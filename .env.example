# ---- Core ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
# Used by the Next.js dev server to proxy /api/* to Express
API_URL=http://localhost:4000

# Leave MONGODB_URI unset to run an in-memory MongoDB (data lost on restart).
# MONGODB_URI=mongodb://localhost:27017/crm
# Leave REDIS_URL unset to use the in-process job queue. Set it for durable BullMQ jobs.
# REDIS_URL=redis://localhost:6379
# Seed demo users/contacts/deals when the database is empty (default true).
# Set false for a real deployment: the app then shows a one-time setup screen so you
# create the first administrator yourself, who invites everyone else.
SEED_ON_START=true

JWT_SECRET=change-me-in-production
JWT_EXPIRES_DAYS=7
COOKIE_SECURE=false

# ---- Language model ------------------------------------------------------
# Pick one. With none set, every AI feature runs its deterministic fallback and
# the app still works end to end.
#   auto (default) = first key found, preferring anthropic > openrouter > groq > custom
AI_PROVIDER=auto

# Free for testing. OpenRouter has a free tier on several models (the :free suffix).
# Get a key at openrouter.ai/keys
# OpenAI. gpt-4o-mini is the default; set gpt-4o for better drafts and summaries.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# OPENROUTER_API_KEY=sk-or-v1-...
# openrouter/free auto-routes across whatever is free today, so it does not go
# stale when a specific free model is retired.
OPENROUTER_MODEL=openrouter/free

# Also free, and much faster. Get a key at console.groq.com/keys
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Paid, best quality. Leave unset while testing on a free tier.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Any other OpenAI-compatible gateway (Together, Fireworks, a local Ollama).
# AI_BASE_URL=https://api.together.xyz/v1
# AI_API_KEY=
# AI_MODEL=
AI_TIMEOUT_MS=45000
AI_MAX_CONCURRENCY=4
# Server-side refusal fallbacks (beta server-side-fallback-2026-07-01, fallbacks: "default")
AI_SERVER_FALLBACKS=true
AI_RATE_LIMIT_PER_MINUTE=30
AI_CIRCUIT_FAILURES=4
AI_CIRCUIT_OPEN_MS=60000

# ---- Embeddings + vector store ------------------------------------------
# auto = Voyage if VOYAGE_API_KEY, else OpenAI if OPENAI_API_KEY, else a local ONNX model (no key needed)
EMBEDDINGS_PROVIDER=auto
# VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
TRANSFORMERS_CACHE_DIR=.cache/transformers
# Pinecone (optional). Index dimension must match the embedding model (384 for MiniLM, 1024 for voyage-3.5-lite, 1536 for text-embedding-3-small).
# PINECONE_API_KEY=
# PINECONE_INDEX=crm-notes

# ---- Risk flagging --------------------------------------------------------
RISK_INACTIVITY_DAYS=14
RISK_SCAN_CRON=0 6 * * *
RISK_SCAN_ON_START=true

# ---- Outbound email -------------------------------------------------------
# Used for invitation links and for sending drafted follow-ups. Without it,
# invitations still work: the link is shown in the app so you can pass it on.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_FROM=crm@example.com

# ---------------------------------------------------------------- integrations
# OAuth client credentials. Without these the Connect buttons explain what is
# missing rather than failing at the platform.
# META_APP_ID=
# META_APP_SECRET=            # also verifies inbound webhook signatures
# META_VERIFY_TOKEN=          # any string; must match the one entered in the Meta app
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=

# Encrypts stored third-party tokens. Falls back to JWT_SECRET, but then
# rotating JWT_SECRET invalidates every connection.
# INTEGRATION_SECRET=

# Where platforms redirect back to. Defaults to WEB_ORIGIN, which proxies /api.
# PUBLIC_API_URL=

# How often the polling fallback runs, for platforms with unreliable webhooks.
INTEGRATION_POLL_CRON=*/15 * * * *

# Email. Without SMTP_URL, invitations show their link on screen instead.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
