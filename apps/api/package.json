{
  "name": "@loom/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx src/scripts/bench.ts",
    "build:serverless": "esbuild serverless/entry.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@loom/shared=../../packages/shared/src/index.ts --outfile=api/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@loom/shared": "1.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.9.4",
    "nodemailer": "^7.0.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
